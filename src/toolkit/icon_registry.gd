class_name IconRegistry
extends RefCounted
## Built-in 32x32 icon catalog + icon-string resolver (port of utils/icons.ts: BUILTIN_ICONS and getIconSrc).
## Assets live in res://assets/builtin_icons (generated by tools/gen_builtin_icons.mjs); the picker
## order/names are in BuiltinIconCatalog. Shell-specific catalogs (wfw/, win95/) live with the shells.

const DIR := "res://assets/builtin_icons/"
const DEFAULT_ID := "default"

static var _files := {}      ## id -> file name (built lazily from the catalog)
static var _scaled := {}     ## "id@scale" -> Texture2D


static func _index() -> void:
	if not _files.is_empty():
		return
	for e in BuiltinIconCatalog.ENTRIES:
		_files[e[0]] = e[2]
	for k in BuiltinIconCatalog.EXTRA_FILES:
		_files[k] = BuiltinIconCatalog.EXTRA_FILES[k]


## [{id, name}] in picker order.
static func builtin_list() -> Array:
	var out := []
	for e in BuiltinIconCatalog.ENTRIES:
		out.append({"id": e[0], "name": e[1]})
	return out


## True for picker ids (and the dialog/app icons "question" / "program-manager").
static func has_builtin(id: String) -> bool:
	_index()
	return _files.has(id)


## res:// path of a built-in icon, "" when unknown.
static func builtin_path(id: String) -> String:
	_index()
	return DIR + String(_files[id]) if _files.has(id) else ""


static func builtin_texture(id: String) -> Texture2D:
	var p := builtin_path(id)
	return Assets.tex(p) if p != "" else null


static func default_item_texture() -> Texture2D:
	return builtin_texture(DEFAULT_ID)


## Port of getIconSrc: returns the source string for an icon value without loading it.
## Built-ins/legacy names -> their res:// path; data:/http(s) URLs and file URLs/paths as the TS did
## (Windows paths become file:/// URLs, UNC paths file:// URLs, unix paths unchanged);
## anything unknown -> the default icon's path.
static func get_icon_src(icon: String) -> String:
	if icon == "":
		return builtin_path(DEFAULT_ID)
	if has_builtin(icon) and icon != "question" and icon != "program-manager":
		return builtin_path(icon)
	if BuiltinIconCatalog.LEGACY.has(icon):
		return builtin_path(BuiltinIconCatalog.LEGACY[icon])
	if icon.begins_with("data:") or icon.begins_with("http"):
		return icon
	if icon.begins_with("file://"):
		return icon
	var normalized := icon.replace("\\", "/")
	var re := RegEx.new()
	re.compile("^[a-zA-Z]:/")
	if re.search(normalized) != null:
		return "file:///" + normalized
	if normalized.begins_with("//"):
		return "file:" + normalized
	if icon.begins_with("/"):
		return icon
	return builtin_path(DEFAULT_ID)


## "file:///C:/x.png" -> "C:/x.png"; "file:///usr/x.png" -> "/usr/x.png"; "file://host/s/x.png" -> "//host/s/x.png".
static func file_url_to_path(url: String) -> String:
	var rest := url.trim_prefix("file:").uri_decode()
	if rest.begins_with("///"):
		rest = rest.substr(2)  # "/C:/x" or "/usr/x"
		var re := RegEx.new()
		re.compile("^/[a-zA-Z]:/")
		if re.search(rest) != null:
			rest = rest.substr(1)
		return rest
	return rest  # "//host/share/x" stays a UNC path


## Resolves an `icon` string (builtin id, legacy name, data: URL, http URL, file path) to a texture.
## Never returns null: falls back to default_item_texture(). Port of getIconSrc semantics.
## http(s) icons are never fetched (the app makes no network requests) and show the default icon.
static func resolve(icon: String) -> Texture2D:
	var src := get_icon_src(icon)
	var tex: Texture2D = null
	if src.begins_with("res://"):
		tex = Assets.tex(src)
	elif src.begins_with("data:"):
		tex = Assets.from_data_url(src)
	elif src.begins_with("http"):
		tex = null
	else:
		var path := file_url_to_path(src) if src.begins_with("file:") else src
		if FileAccess.file_exists(path):
			tex = Assets.tex(path)
	return tex if tex != null else default_item_texture()


## Crisper variant for integer UI scales: built-in SVG icons are re-rasterized at 32*scale pixels
## (the shell then draws the texture at logical 32x32); everything else is resolve().
static func texture_scaled(icon: String, scale: int) -> Texture2D:
	var src := get_icon_src(icon)
	if scale <= 1 or not src.begins_with("res://") or not src.ends_with(".svg"):
		return resolve(icon)
	var key := "%s@%d" % [src, scale]
	if _scaled.has(key):
		return _scaled[key]
	var bytes := FileAccess.get_file_as_bytes(src)
	var tex: Texture2D = null
	if not bytes.is_empty():
		var img := IconImage.load_svg(bytes, 32 * scale)
		if img != null:
			tex = ImageTexture.create_from_image(img)
	if tex == null:
		tex = resolve(icon)
	_scaled[key] = tex
	return tex
